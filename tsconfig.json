{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "exactOptionalPropertyTypes": true,
        "lib": ["ES2022"],
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "noUncheckedIndexedAccess": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "target": "ES2022",
        "types": []
    },
    "include": ["src/**/*.ts"]
}
